{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LUMI USB Telepítő",
  "version": "0.1.0",
  "identifier": "com.nomad.lumi.usb-installer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LUMI USB Telepítő",
        "width": 560,
        "height": 620,
        "minWidth": 480,
        "minHeight": 560,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "decorations": true,
        "backgroundColor": "#f7f7f5"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp"
      }
    }
  }
}
